Options -Indexes
RewriteEngine On
# Blog post URLs: /blog/{slug} → post.php?slug={slug}
RewriteRule ^blog/([a-z0-9-]+)$ post.php?slug=$1 [NC,L,QSA]
# RSS feed URL: /feed → feed.php
RewriteRule ^feed$ feed.php [NC,L]
# 1. Check if the request is NOT for a directory
RewriteCond %{REQUEST_FILENAME} !-d
# 2. Check if the requested filename with .php added exists as a file
RewriteCond %{REQUEST_FILENAME}\.php -f
# 3. Internally redirect to the .php file
RewriteRule ^([^\.]+)$ $1.php [NC,L]
