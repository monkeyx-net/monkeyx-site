Options -Indexes
RewriteEngine On
# Blog post URLs: /blog/{slug} → post.php?slug={slug}
RewriteRule ^blog/([a-z0-9-]+)$ post.php?slug=$1 [NC,L,QSA]
# RSS feed URL: /feed → feed.php
RewriteRule ^feed$ feed.php [NC,L]
# 1. Check if the request is NOT for a directory
RewriteCond %{REQUEST_FILENAME} !-d
# 2. Check if the requested filename with .php added exists as a file
RewriteCond %{REQUEST_FILENAME}\.php -f
# 3. Internally redirect to the .php file
RewriteRule ^([^\.]+)$ $1.php [NC,L]

<IfModule mod_headers.c>
    # Images & icons (fixed/add-only names) — cache 30 days
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    # CSS/JS (edited in place, no cache-busting) — cache 1 day so edits propagate fast
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=86400, public"
    </FilesMatch>
</IfModule>
